{%- comment -%}
  SETUP:
  1. Create a product "Ambassador Application" priced at $35. Copy its variant ID.
  2. Admin → Online Store → Pages → create a page, set template to "page.ambassador".
  3. Theme Editor → select that page → set Variant ID, deadline, and copy fields.

  PREVIEW: The page is live at /pages/ambassador but unlinked from navigation.
  To test the form flow, ensure the Variant ID is set and submit with real data.
{%- endcomment -%}

{%- style -%}
  @import url('https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&family=Montserrat:wght@400;500;600;700;900&family=Dancing+Script:wght@600;700&display=swap');

  /* ── Reset & page wrapper ── */
  .amb-page {
    font-family: 'Montserrat', sans-serif;
    color: #2a1a1a;
    max-width: 680px;
    margin: 0 auto;
    padding: 0 1.5rem 5rem;
  }

  /* ── Header ── */
  .amb-header {
    text-align: center;
    padding: 3.5rem 0 2rem;
  }
  .amb-header__pivot {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.5rem;
    font-weight: 400;
    letter-spacing: 0.55em;
    margin: 0 0 0.2rem;
    color: #2a1a1a;
  }
  .amb-header__heart {
    color: #d4849a;
    font-size: 1rem;
    margin: 0 0 0.2rem;
    line-height: 1;
  }
  .amb-header__dancewear {
    font-size: 0.7rem;
    font-weight: 500;
    letter-spacing: 0.45em;
    text-transform: uppercase;
    color: #7a5555;
    margin: 0 0 1.25rem;
  }
  .amb-header__title {
    margin: 0 0 1.5rem;
    line-height: 1;
  }
  .amb-header__ambassador {
    display: block;
    font-family: 'Montserrat', sans-serif;
    font-size: clamp(3rem, 12vw, 5.5rem);
    font-weight: 900;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: #1a1010;
    line-height: 1;
  }
  .amb-header__search-line {
    display: block;
    line-height: 1.1;
  }
  .amb-header__search {
    font-family: 'Dancing Script', cursive;
    font-size: clamp(2.8rem, 10vw, 4.8rem);
    font-weight: 700;
    color: #c97a8e;
    letter-spacing: 0.01em;
  }
  .amb-header__search-heart {
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    color: #d4849a;
    vertical-align: middle;
    margin-left: 0.15em;
  }
  .amb-header__tagline {
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.22em;
    text-transform: uppercase;
    color: #7a5555;
    line-height: 2;
    margin: 0;
  }

  /* ── Oval pitch ── */
  .amb-oval-wrap {
    display: flex;
    justify-content: center;
    margin: 2.5rem 0 3rem;
  }
  .amb-oval {
    background: #f0d8d8;
    border-radius: 50%;
    padding: 4.5rem 3.5rem;
    text-align: center;
    width: 100%;
    max-width: 560px;
    box-sizing: border-box;
  }
  .amb-oval__upper {
    font-size: 0.72rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #4a2a2a;
    line-height: 1.8;
    margin: 0 0 1.25rem;
  }
  .amb-oval__lower {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-style: italic;
    color: #4a2a2a;
    line-height: 1.7;
    margin: 0;
  }

  /* ── Perks grid ── */
  .amb-perks {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2.5rem 1.5rem;
    margin: 0 0 3rem;
    text-align: center;
  }
  .amb-perk {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0.9rem;
  }
  .amb-perk__icon {
    width: 80px;
    height: 80px;
    background: #f0d8d8;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
    color: #4a2a2a;
    flex-shrink: 0;
  }
  .amb-perk__icon svg {
    width: 28px;
    height: 28px;
    stroke: #4a2a2a;
    fill: none;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .amb-perk__label {
    font-size: 0.7rem;
    font-weight: 700;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #2a1a1a;
    line-height: 1.6;
    margin: 0;
  }
  .amb-perk__sub {
    font-size: 0.68rem;
    color: #9a6060;
    margin: -0.5rem 0 0;
    letter-spacing: 0.04em;
  }

  /* ── Top CTA button ── */
  .amb-cta-wrap {
    display: flex;
    justify-content: center;
    margin: 0 0 3.5rem;
  }
  .amb-cta-btn {
    display: inline-block;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    color: #2a1a1a;
    background: #f0d8d8;
    padding: 1.1rem 3rem;
    border-radius: 4px;
    transition: background 0.2s;
    min-width: 280px;
    text-align: center;
  }
  .amb-cta-btn:hover { background: #e4c4c4; }

  /* ── Divider quote ── */
  .amb-quote-section {
    text-align: center;
    margin: 0 0 0;
    padding: 0 0 3rem;
    border-bottom: none;
  }
  .amb-hr {
    border: none;
    border-top: 1px solid #ddd;
    width: 80px;
    margin: 0 auto 2rem;
  }
  .amb-community-quote {
    font-family: 'Dancing Script', cursive;
    font-size: 1.65rem;
    font-weight: 600;
    color: #2a1a1a;
    margin: 0;
    line-height: 1.4;
  }
  .amb-community-quote .amb-quote-heart {
    color: #d4849a;
    font-family: 'Montserrat', sans-serif;
    font-size: 1rem;
    vertical-align: middle;
  }
  .amb-community-quote em {
    font-family: 'Dancing Script', cursive;
    font-style: italic;
  }

  /* ── Stats band ── */
  .amb-stats-band {
    background: #f0d8d8;
    margin: 0 -1.5rem;
    padding: 4rem 3rem;
    text-align: center;
  }
  .amb-stats-row {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
    margin-bottom: 2.5rem;
  }
  .amb-stat__num {
    font-family: 'Cormorant Garamond', serif;
    font-size: 3.5rem;
    font-weight: 400;
    color: #2a1a1a;
    line-height: 1;
    margin: 0 0 0.35rem;
  }
  .amb-stat__num sup {
    font-size: 1.5rem;
    vertical-align: super;
  }
  .amb-stat__label {
    font-size: 0.62rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #6a3a3a;
    margin: 0;
    line-height: 1.5;
  }
  .amb-stats__quote {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.35rem;
    font-style: italic;
    color: #2a1a1a;
    line-height: 1.7;
    margin: 0 0 1.5rem;
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .amb-stats__body {
    font-size: 0.82rem;
    color: #4a2a2a;
    line-height: 1.8;
    margin: 0 0 2rem;
    max-width: 520px;
    margin-left: auto;
    margin-right: auto;
  }
  .amb-stats__disclaimer {
    font-family: 'Cormorant Garamond', serif;
    font-size: 0.9rem;
    font-style: italic;
    color: #7a5050;
    margin: 1.5rem auto 0;
    max-width: 480px;
    line-height: 1.6;
  }
  .amb-stats__contact {
    font-size: 0.75rem;
    color: #7a5050;
    margin: 1.5rem 0 0;
    letter-spacing: 0.03em;
  }
  .amb-stats__contact a {
    color: #c97a8e;
    text-decoration: underline;
  }

  /* ── Form section ── */
  .amb-form-section {
    padding-top: 3.5rem;
  }
  .amb-form-section__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: 2rem;
    font-weight: 400;
    text-align: center;
    margin: 0 0 0.25rem;
    color: #1e1214;
  }
  .amb-form-section__sub {
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: #9e7575;
    text-align: center;
    margin: 0 0 2.5rem;
  }

  .amb-form {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem 1.5rem;
  }
  @media (max-width: 580px) {
    .amb-perks { grid-template-columns: repeat(3, 1fr); gap: 1.5rem 0.75rem; }
    .amb-perk__icon { width: 60px; height: 60px; }
    .amb-perk__icon svg { width: 22px; height: 22px; }
    .amb-stats-row { grid-template-columns: repeat(3, 1fr); }
    .amb-stat__num { font-size: 2.5rem; }
    .amb-form { grid-template-columns: 1fr; }
    .amb-oval { padding: 3.5rem 2.5rem; }
  }

  .amb-field { display: flex; flex-direction: column; gap: 0.35rem; }
  .amb-field--full { grid-column: 1 / -1; }

  .amb-label {
    font-size: 0.7rem;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: #6b4f4f;
  }
  .amb-label abbr { text-decoration: none; color: #c9a09a; margin-left: 2px; }

  .amb-input, .amb-textarea {
    width: 100%;
    font-family: 'Montserrat', sans-serif;
    font-size: 0.88rem;
    color: #2a1f1f;
    background: #fff;
    border: 1px solid #d9c5c0;
    border-radius: 2px;
    padding: 0.65rem 0.75rem;
    transition: border-color 0.2s;
    box-sizing: border-box;
  }
  .amb-input:focus, .amb-textarea:focus { outline: none; border-color: #c9a09a; }
  .amb-textarea { resize: vertical; min-height: 100px; }

  .amb-help { font-size: 0.7rem; color: #9e7575; }

  .amb-file-label {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    cursor: pointer;
    padding: 0.65rem 0.75rem;
    border: 1px dashed #d9c5c0;
    border-radius: 2px;
    background: #fdf6f0;
    font-size: 0.82rem;
    color: #9e7575;
    transition: border-color 0.2s;
  }
  .amb-file-label:hover { border-color: #c9a09a; }
  .amb-file-label input[type="file"] { display: none; }
  .amb-file-name { font-size: 0.75rem; color: #6b4f4f; }

  .amb-agreement { grid-column: 1 / -1; margin-top: 0.5rem; }
  .amb-agreement__heading {
    font-family: 'Cormorant Garamond', serif;
    font-size: 1.2rem;
    font-weight: 600;
    margin: 0 0 0.75rem;
  }
  .amb-agreement__scroll {
    height: 240px;
    overflow-y: scroll;
    border: 1px solid #d9c5c0;
    border-radius: 2px;
    padding: 1.25rem 1.5rem;
    font-size: 0.82rem;
    line-height: 1.75;
    color: #4a3535;
    background: #fdf6f0;
    margin-bottom: 1rem;
  }
  .amb-checkbox-row {
    display: flex;
    gap: 0.75rem;
    align-items: flex-start;
    margin-bottom: 1.25rem;
  }
  .amb-checkbox-row input[type="checkbox"] {
    margin-top: 3px;
    accent-color: #c9a09a;
    width: 16px;
    height: 16px;
    flex-shrink: 0;
  }
  .amb-checkbox-row label { font-size: 0.82rem; line-height: 1.55; color: #4a3535; }

  .amb-sig-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.25rem;
  }
  @media (max-width: 500px) { .amb-sig-grid { grid-template-columns: 1fr; } }

  .amb-error {
    display: none;
    grid-column: 1 / -1;
    background: #fdf0f0;
    border: 1px solid #e8a0a0;
    border-radius: 2px;
    padding: 0.75rem 1rem;
    font-size: 0.82rem;
    color: #8b2020;
    line-height: 1.5;
  }
  .amb-error.is-visible { display: block; }

  .amb-submit-row {
    grid-column: 1 / -1;
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    gap: 0.5rem;
    margin-top: 0.5rem;
  }
  .amb-submit {
    font-family: 'Montserrat', sans-serif;
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    color: #2a1a1a;
    background: #f0d8d8;
    border: none;
    border-radius: 4px;
    padding: 1rem 2.25rem;
    cursor: pointer;
    transition: background 0.2s;
  }
  .amb-submit:hover { background: #e4c4c4; }
  .amb-submit:disabled { opacity: 0.6; cursor: not-allowed; }
  .amb-submit-note { font-size: 0.7rem; color: #9e7575; }
{%- endstyle -%}

<div class="amb-page">

  {%- comment -%} ── HERO ── {%- endcomment -%}
  <div class="amb-header">
    <p class="amb-header__pivot">PIVOT</p>
    <p class="amb-header__heart">♥</p>
    <p class="amb-header__dancewear">Dancewear</p>
    <h1 class="amb-header__title">
      <span class="amb-header__ambassador">AMBASSADOR</span>
      <span class="amb-header__search-line">
        <span class="amb-header__search">Search<span class="amb-header__search-heart">♥</span></span>
      </span>
    </h1>
    <p class="amb-header__tagline">Love Dance. Love Pivot.<br>Apply Now.</p>
  </div>

  {%- comment -%} ── OVAL PITCH ── {%- endcomment -%}
  <div class="amb-oval-wrap">
    <div class="amb-oval">
      <p class="amb-oval__upper">We're looking for dancers who are passionate, confident, and love to create.</p>
      <p class="amb-oval__lower">If you're ready to represent a brand that's all about style, performance, and individuality, we want you!</p>
    </div>
  </div>

  {%- comment -%} ── PERKS ── {%- endcomment -%}
  <div class="amb-perks">

    <div class="amb-perk">
      <div class="amb-perk__icon">
        <svg viewBox="0 0 24 24"><rect x="3" y="8" width="18" height="13" rx="1"/><path d="M21 12H3"/><path d="M12 8V21"/><path d="M12 8c0-2 1.5-4 3-4s2 2 0 4"/><path d="M12 8c0-2-1.5-4-3-4s-2 2 0 4"/></svg>
      </div>
      <p class="amb-perk__label">Free Pivot Set<br>Every Quarter</p>
      <p class="amb-perk__sub">a $320 value</p>
    </div>

    <div class="amb-perk">
      <div class="amb-perk__icon">
        <svg viewBox="0 0 24 24"><path d="M20.59 13.41l-7.17 7.17a2 2 0 01-2.83 0L2 12V2h10l8.59 8.59a2 2 0 010 2.82z"/><circle cx="7" cy="7" r="1" fill="#4a2a2a"/></svg>
      </div>
      <p class="amb-perk__label">10% Off Code<br>to Share</p>
    </div>

    <div class="amb-perk">
      <div class="amb-perk__icon">
        <svg viewBox="0 0 24 24"><path d="M12 2l1.8 5.4H19l-4.6 3.4 1.8 5.4L12 13l-4.2 3.2 1.8-5.4L5 7.4h5.2L12 2z"/></svg>
      </div>
      <p class="amb-perk__label">Early Access<br>to New Collections</p>
    </div>

    <div class="amb-perk">
      <div class="amb-perk__icon">
        <svg viewBox="0 0 24 24"><path d="M23 19a2 2 0 01-2 2H3a2 2 0 01-2-2V8a2 2 0 012-2h4l2-3h6l2 3h4a2 2 0 012 2z"/><circle cx="12" cy="13" r="4"/></svg>
      </div>
      <p class="amb-perk__label">Featured on<br>Our Socials</p>
    </div>

    <div class="amb-perk">
      <div class="amb-perk__icon">
        <svg viewBox="0 0 24 24"><path d="M20.84 4.61a5.5 5.5 0 00-7.78 0L12 5.67l-1.06-1.06a5.5 5.5 0 00-7.78 7.78l1.06 1.06L12 21.23l7.78-7.78 1.06-1.06a5.5 5.5 0 000-7.78z"/></svg>
      </div>
      <p class="amb-perk__label">Modeling &amp;<br>Content Opps</p>
    </div>

    <div class="amb-perk">
      <div class="amb-perk__icon">
        <svg viewBox="0 0 24 24"><path d="M12 3l1.5 4L18 8.5l-3.5 3 1 4.5L12 14l-3.5 2 1-4.5L6 8.5l4.5-.5L12 3z"/><path d="M19 15l.6 1.8 1.9.7-1.9.7-.6 1.8-.6-1.8-1.9-.7 1.9-.7.6-1.8z"/><path d="M5 16l.4 1.2 1.3.5-1.3.5L5 19.4l-.4-1.2-1.3-.5 1.3-.5L5 16z"/></svg>
      </div>
      <p class="amb-perk__label">Exclusive Perks<br>&amp; Giveaways</p>
    </div>

  </div>

  {%- comment -%} ── TOP CTA ── {%- endcomment -%}
  <div class="amb-cta-wrap">
    <a href="#amb-form" class="amb-cta-btn">Apply Now &nbsp;→</a>
  </div>

  {%- comment -%} ── DIVIDER QUOTE ── {%- endcomment -%}
  <div class="amb-quote-section">
    <hr class="amb-hr">
    <p class="amb-community-quote">More than dancewear. <span class="amb-quote-heart">♥</span> <em>It's a community.</em></p>
  </div>

  {%- comment -%} ── STATS BAND ── {%- endcomment -%}
  <div class="amb-stats-band">

    <div class="amb-stats-row">
      <div class="amb-stat">
        <p class="amb-stat__num"><sup>$</sup>35</p>
        <p class="amb-stat__label">Non-Refundable Fee</p>
      </div>
      <div class="amb-stat">
        <p class="amb-stat__num">4<sup>×</sup></p>
        <p class="amb-stat__label">Free Sets / Year</p>
      </div>
      <div class="amb-stat">
        <p class="amb-stat__num">20<sup>%</sup></p>
        <p class="amb-stat__label">Off Just for Applying</p>
      </div>
    </div>

    <p class="amb-stats__quote">Apply with a headshot, a short dance video, your socials, and a few questions. Sign the agreement, pay the $35 fee, and you're in the running.</p>

    <p class="amb-stats__body">In return, each month you'll post one original Instagram Reel, one Story, and one feed post featuring Pivot, all fresh, and tagged @pivotdancewear.</p>

    <div class="amb-cta-wrap" style="margin-bottom:0;">
      <a href="#amb-form" class="amb-cta-btn">Start My Application &nbsp;→</a>
    </div>

    <p class="amb-stats__disclaimer">A parent or guardian applies and signs for dancers under 18. Applying and paying the fee does not guarantee acceptance.</p>

    <p class="amb-stats__contact">Pivot Dancewear &middot; Questions? Email Jessica at <a href="mailto:hello@pivotdancewear.com">hello@pivotdancewear.com</a></p>

  </div>

  {%- comment -%} ── APPLICATION FORM ── {%- endcomment -%}
  <div class="amb-form-section" id="amb-form">
    <h2 class="amb-form-section__heading">{{ section.settings.form_heading }}</h2>
    <p class="amb-form-section__sub">Application · $35 non-refundable fee</p>

    <form
      class="amb-form"
      action="/cart/add"
      method="post"
      enctype="multipart/form-data"
      novalidate
    >
      <input type="hidden" name="id" value="{{ section.settings.variant_id }}">
      <input type="hidden" name="quantity" value="1">
      <input type="hidden" name="return_to" value="/checkout">

      <div class="amb-field">
        <label class="amb-label" for="amb-guardian-name">Parent / Guardian Name <abbr title="required">*</abbr></label>
        <input class="amb-input" type="text" id="amb-guardian-name" name="properties[Parent/Guardian Name]" required autocomplete="name">
      </div>

      <div class="amb-field">
        <label class="amb-label" for="amb-guardian-email">Parent / Guardian Email <abbr title="required">*</abbr></label>
        <input class="amb-input" type="email" id="amb-guardian-email" name="properties[Parent/Guardian Email]" required autocomplete="email">
      </div>

      <div class="amb-field">
        <label class="amb-label" for="amb-dancer-name">Dancer Name <abbr title="required">*</abbr></label>
        <input class="amb-input" type="text" id="amb-dancer-name" name="properties[Dancer Name]" required>
      </div>

      <div class="amb-field">
        <label class="amb-label" for="amb-dancer-age">Dancer Age <abbr title="required">*</abbr></label>
        <input class="amb-input" type="number" id="amb-dancer-age" name="properties[Dancer Age]" required min="1" max="25">
      </div>

      <div class="amb-field">
        <label class="amb-label" for="amb-city-state">City &amp; State</label>
        <input class="amb-input" type="text" id="amb-city-state" name="properties[City & State]" placeholder="e.g. Austin, TX">
      </div>

      <div class="amb-field">
        <label class="amb-label" for="amb-instagram">Instagram Handle <abbr title="required">*</abbr></label>
        <input class="amb-input" type="text" id="amb-instagram" name="properties[Instagram Handle]" required placeholder="@handle">
      </div>

      <div class="amb-field">
        <label class="amb-label" for="amb-tiktok">TikTok Handle</label>
        <input class="amb-input" type="text" id="amb-tiktok" name="properties[TikTok Handle]" placeholder="@handle">
      </div>

      <div class="amb-field">
        <label class="amb-label" for="amb-followers">Approx. Follower Count</label>
        <input class="amb-input" type="text" id="amb-followers" name="properties[Approx. Follower Count]" placeholder="e.g. 2,500">
      </div>

      <div class="amb-field amb-field--full">
        <label class="amb-label" for="amb-video">Dance Video Link <abbr title="required">*</abbr></label>
        <input class="amb-input" type="url" id="amb-video" name="properties[Dance Video Link]" required placeholder="https://…">
        <span class="amb-help">Paste a YouTube, Instagram, TikTok, or Google Drive link</span>
      </div>

      <div class="amb-field amb-field--full">
        <label class="amb-label" for="amb-styles">Dance Styles</label>
        <input class="amb-input" type="text" id="amb-styles" name="properties[Dance Styles]" placeholder="e.g. Contemporary, Jazz, Lyrical">
      </div>

      <div class="amb-field amb-field--full">
        <label class="amb-label" for="amb-why">Why do you want to be a Pivot Ambassador? <abbr title="required">*</abbr></label>
        <textarea class="amb-textarea" id="amb-why" name="properties[Why do you want to be a Pivot Ambassador?]" required rows="4"></textarea>
      </div>

      <div class="amb-field amb-field--full">
        <label class="amb-label" for="amb-journey">Tell us about your dance journey <abbr title="required">*</abbr></label>
        <textarea class="amb-textarea" id="amb-journey" name="properties[Tell us about your dance journey]" required rows="4"></textarea>
      </div>

      <div class="amb-field amb-field--full">
        <span class="amb-label">Headshot <abbr title="required">*</abbr></span>
        <label class="amb-file-label" for="amb-headshot">
          <input type="file" id="amb-headshot" name="properties[Headshot]" accept="image/*" required>
          <span>Choose a photo (JPG, PNG — max 20 MB)</span>
        </label>
        <span class="amb-file-name" id="amb-selected-file"></span>
        <span class="amb-help">Max file size: 20 MB</span>
      </div>

      <div class="amb-field amb-field--full amb-agreement">
        <h3 class="amb-agreement__heading">Ambassador Agreement</h3>
        <div class="amb-agreement__scroll">
          {%- render 'ambassador-agreement' -%}
        </div>
        <div class="amb-checkbox-row">
          <input type="checkbox" id="amb-agree-check"
            name="properties[Agreement Accepted]"
            value="Yes — I have read and agree to the Pivot Ambassador Agreement"
            required>
          <label for="amb-agree-check">I have read the full Pivot Ambassador Agreement above and agree to its terms on behalf of myself and my dancer.</label>
        </div>
        <div class="amb-sig-grid">
          <div class="amb-field">
            <label class="amb-label" for="amb-signature">Signature — Parent/Guardian full name <abbr title="required">*</abbr></label>
            <input class="amb-input" type="text" id="amb-signature" name="properties[Signature (Parent/Guardian full name)]" required placeholder="Type your full legal name">
          </div>
          <div class="amb-field">
            <label class="amb-label" for="amb-sig-date">Date</label>
            <input class="amb-input" type="text" id="amb-sig-date" name="properties[Signature Date]" readonly>
          </div>
        </div>
      </div>

      <div class="amb-error" id="amb-error" role="alert"></div>

      <div class="amb-submit-row">
        <button type="submit" class="amb-submit" id="amb-submit">Submit application &amp; pay $35 →</button>
        <span class="amb-submit-note">You'll be taken to Shopify checkout to complete your $35 payment.</span>
      </div>

    </form>
  </div>

</div>

<script>
(function () {
  const dateField = document.getElementById('amb-sig-date');
  if (dateField) {
    dateField.value = new Date().toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
  }

  const fileInput = document.getElementById('amb-headshot');
  const fileDisplay = document.getElementById('amb-selected-file');
  if (fileInput && fileDisplay) {
    fileInput.addEventListener('change', function () {
      const f = this.files[0];
      fileDisplay.textContent = f ? f.name + ' (' + (f.size / 1024 / 1024).toFixed(1) + ' MB)' : '';
    });
  }

  const form = document.querySelector('.amb-form');
  const errorBanner = document.getElementById('amb-error');
  const submitBtn = document.getElementById('amb-submit');
  if (!form) return;

  form.addEventListener('submit', function (e) {
    const errors = [];

    form.querySelectorAll('[required]:not([type="checkbox"]):not([type="file"])').forEach(function (field) {
      if (!field.value.trim()) {
        const label = form.querySelector('label[for="' + field.id + '"]');
        errors.push('"' + (label ? label.textContent.replace('*','').trim() : field.name) + '" is required.');
      }
    });

    const video = document.getElementById('amb-video');
    if (video && video.value.trim()) {
      try { new URL(video.value.trim()); } catch(_) {
        errors.push('Dance Video Link must be a valid URL.');
      }
    }

    const headshot = fileInput ? fileInput.files[0] : null;
    if (!headshot) {
      errors.push('A headshot photo is required.');
    } else if (headshot.size > 20 * 1024 * 1024) {
      errors.push('Headshot must be under 20 MB (yours is ' + (headshot.size/1024/1024).toFixed(1) + ' MB).');
    }

    const checkbox = document.getElementById('amb-agree-check');
    if (checkbox && !checkbox.checked) errors.push('You must accept the Ambassador Agreement.');

    if (errors.length) {
      e.preventDefault();
      errorBanner.innerHTML = '<strong>Please fix the following:</strong><ul style="margin:.5rem 0 0 1.25rem;padding:0">' +
        errors.map(function(e){ return '<li>'+e+'</li>'; }).join('') + '</ul>';
      errorBanner.classList.add('is-visible');
      errorBanner.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
    } else {
      errorBanner.classList.remove('is-visible');
      submitBtn.disabled = true;
      submitBtn.textContent = 'Submitting…';
    }
  });
})();
</script>

{% schema %}
{
  "name": "Ambassador Application",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "variant_id",
      "label": "Ambassador Application Variant ID",
      "default": "53608488534325",
      "info": "The variant ID of your $35 'Ambassador Application' product."
    },
    {
      "type": "text",
      "id": "form_heading",
      "label": "Form heading",
      "default": "Apply Now"
    }
  ],
  "presets": [
    { "name": "Ambassador Application" }
  ]
}
{% endschema %}
