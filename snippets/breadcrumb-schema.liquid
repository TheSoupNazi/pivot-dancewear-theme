{%- comment -%}
  BreadcrumbList structured data for product, collection, article and blog pages.
{%- endcomment -%}
{%- liquid
  assign home_url = request.origin | append: '/'
  case request.page_type
    when 'product'
      if collection
        assign mid_name = collection.title
        assign mid_url = request.origin | append: collection.url
      else
        assign mid_name = 'Shop'
        assign mid_url = request.origin | append: '/collections/all'
      endif
      assign leaf_name = product.title
      assign leaf_url = request.origin | append: product.url
    when 'collection'
      assign leaf_name = collection.title
      assign leaf_url = request.origin | append: collection.url
    when 'article'
      assign mid_name = blog.title
      assign mid_url = request.origin | append: blog.url
      assign leaf_name = article.title
      assign leaf_url = request.origin | append: article.url
    when 'blog'
      assign leaf_name = blog.title
      assign leaf_url = request.origin | append: blog.url
  endcase
-%}
{%- if leaf_name != blank -%}
  <script type="application/ld+json">
    {
      "@context": "https://schema.org",
      "@type": "BreadcrumbList",
      "itemListElement": [
        { "@type": "ListItem", "position": 1, "name": "Home", "item": {{ home_url | json }} },
        {%- if mid_name != blank -%}
          { "@type": "ListItem", "position": 2, "name": {{ mid_name | json }}, "item": {{ mid_url | json }} },
          { "@type": "ListItem", "position": 3, "name": {{ leaf_name | json }}, "item": {{ leaf_url | json }} }
        {%- else -%}
          { "@type": "ListItem", "position": 2, "name": {{ leaf_name | json }}, "item": {{ leaf_url | json }} }
        {%- endif -%}
      ]
    }
  </script>
{%- endif -%}
